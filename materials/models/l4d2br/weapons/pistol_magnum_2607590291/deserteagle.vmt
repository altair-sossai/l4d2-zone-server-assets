VertexLitGeneric
{
//basics
"$baseTexture" "models/l4d2br/weapons/pistol_magnum_2607590291/deserteagle"
"$bumpmap" 	"models/l4d2br/weapons/pistol_magnum_2607590291/deserteagle_normal"

//phong
$phong 1
$phongboost 4
$phongalbedoboost 60
$phongfresnelranges "[.8 .8 1]"
