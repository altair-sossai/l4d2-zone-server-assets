VertexLitGeneric
{
	$baseTexture                    	"models/l4d2br/weapons/pistol_magnum_3380373401/deserteagle"
	$bumpmap                         "models/l4d2br/weapons/pistol_magnum_3380373401/deserteagle_normal"
	$phongexponenttexture  	"models/l4d2br/weapons/pistol_magnum_3380373401/deserteagle_exp"

	$phong 1
	$phongboost "125.0"
	$phongfresnelranges "[1.0 1.3 1.1]"
	$phongalbedotint 1

	$envmap env_cubemap
	$normalmapalphaenvmapmask 1
	$envmapfresnel 1
	$envmaptint "[0.05 0.05 0.05]"

	$selfillum 1 
	
	"$detail" "models/infected/hunter/hunter_01_detail.vtf"

	"$detailscale" "1.75" // Edit it if you want to
	"$detailblendfactor" .001	
	"$detailblendmode" 0
	"$detailAmount" "0"

	"Proxies"
	{
		"BloodyHands"
		{
			"resultVar" "$detailAmount" 
		}

		"Equals"
		{
			"srcVar1" "$detailAmount" 
			"resultVar" "$detailblendfactor"
		}
	}
}

